CREATE GRAPH HHGoa()

USE GRAPH HHGoa

# Vertices
CREATE VERTEX Customer(PRIMARY_ID customer_id STRING, card_count INT) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX Card(PRIMARY_ID card_id STRING, customer_id STRING, card1 STRING, card2 STRING, card3 STRING, card4 STRING, card5 STRING, card6 STRING, card_network STRING, card_type STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX Transaction(PRIMARY_ID txn_id STRING, transaction_dt INT, ts DATETIME, amount DOUBLE, product_cd STRING, channel STRING, risk_score DOUBLE, addr1 STRING, addr2 STRING, p_emaildomain STRING, r_emaildomain STRING, dist1 DOUBLE, dist2 DOUBLE) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX DeviceProfile(PRIMARY_ID device_id STRING, device_info STRING, os STRING, browser STRING, screen STRING, device_type STRING, is_new_for_account BOOL, proxy_type STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX EmailDomain(PRIMARY_ID domain STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX BillingRegion(PRIMARY_ID region_code STRING, country_code STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX ClosedCase(PRIMARY_ID case_id STRING, customer_id STRING, card_id STRING, opened_at DATETIME, closed_at DATETIME, outcome STRING, pattern STRING, first_fraud_txn_id STRING, n_txns INT, exposure_usd DOUBLE, actions_taken STRING, report_filed BOOL, analyst_notes STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX InvestigationCase(PRIMARY_ID case_id STRING, opened_at DATETIME, trigger_type STRING, trigger_text STRING, status STRING, verdict STRING, fraud_probability DOUBLE, pattern STRING, pattern_description STRING, exposure_usd DOUBLE, summary STRING, stop_reason STRING, written_to_graph BOOL) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX ResolvedCase(PRIMARY_ID resolved_id STRING, original_case_id STRING, closed_at DATETIME, outcome STRING, pattern STRING, exposure_usd DOUBLE, summary STRING, status STRING, superseded_by STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX DocumentedPattern(PRIMARY_ID pattern_name STRING, description STRING, policy_rule STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"
CREATE VERTEX Evidence(PRIMARY_ID evidence_id STRING, claim STRING, source STRING, ref STRING, entity_ids STRING) WITH STATS="OUTDEGREE_BY_EDGETYPE", PRIMARY_ID_AS_ATTRIBUTE="true"

# Edges
CREATE DIRECTED EDGE OWNS(FROM Customer, TO Card) WITH REVERSE_EDGE="OWNS_REVERSE"
CREATE DIRECTED EDGE MADE(FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_REVERSE"
CREATE DIRECTED EDGE FROM_DEVICE(FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="FROM_DEVICE_REVERSE"
CREATE DIRECTED EDGE PURCHASER_EMAIL(FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="PURCHASER_EMAIL_REVERSE"
CREATE DIRECTED EDGE BILLED_IN(FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="BILLED_IN_REVERSE"
CREATE DIRECTED EDGE NEXT(FROM Transaction, TO Transaction) WITH REVERSE_EDGE="NEXT_REVERSE"

CREATE DIRECTED EDGE INVOLVES_TXN(FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVES_TXN_REVERSE"
CREATE DIRECTED EDGE ON_CARD(FROM ClosedCase, TO Card) WITH REVERSE_EDGE="ON_CARD_REVERSE"
CREATE DIRECTED EDGE CONNECTED_TO(FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CONNECTED_TO_REVERSE"
CREATE DIRECTED EDGE INVOLVES_CARD(FROM ClosedCase, TO Card) WITH REVERSE_EDGE="INVOLVES_CARD_REVERSE"
CREATE DIRECTED EDGE INVOLVES_CUSTOMER(FROM ClosedCase, TO Customer) WITH REVERSE_EDGE="INVOLVES_CUSTOMER_REVERSE"
CREATE DIRECTED EDGE INVOLVES_DEVICE(FROM ClosedCase, TO DeviceProfile) WITH REVERSE_EDGE="INVOLVES_DEVICE_REVERSE"
CREATE DIRECTED EDGE INVOLVES_REGION(FROM ClosedCase, TO BillingRegion) WITH REVERSE_EDGE="INVOLVES_REGION_REVERSE"

CREATE DIRECTED EDGE INVESTIGATES(FROM InvestigationCase, TO Transaction) WITH REVERSE_EDGE="INVESTIGATES_REVERSE"
CREATE DIRECTED EDGE HAS_EVIDENCE(FROM InvestigationCase, TO Evidence) WITH REVERSE_EDGE="HAS_EVIDENCE_REVERSE"
CREATE DIRECTED EDGE RESOLVED_AS(FROM InvestigationCase, TO ResolvedCase) WITH REVERSE_EDGE="RESOLVED_AS_REVERSE"
CREATE DIRECTED EDGE MATCHED_PATTERN(FROM ResolvedCase, TO DocumentedPattern) WITH REVERSE_EDGE="MATCHED_PATTERN_REVERSE"
CREATE DIRECTED EDGE INVOLVED_ENTITY_CARD(FROM ResolvedCase, TO Card) WITH REVERSE_EDGE="INVOLVED_ENTITY_CARD_REVERSE"
CREATE DIRECTED EDGE INVOLVED_ENTITY_CUSTOMER(FROM ResolvedCase, TO Customer) WITH REVERSE_EDGE="INVOLVED_ENTITY_CUSTOMER_REVERSE"
CREATE DIRECTED EDGE INVOLVED_ENTITY_DEVICE(FROM ResolvedCase, TO DeviceProfile) WITH REVERSE_EDGE="INVOLVED_ENTITY_DEVICE_REVERSE"
CREATE DIRECTED EDGE INVOLVED_ENTITY_REGION(FROM ResolvedCase, TO BillingRegion) WITH REVERSE_EDGE="INVOLVED_ENTITY_REGION_REVERSE"
