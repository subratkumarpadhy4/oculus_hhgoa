DROP ALL

// ============================================================================
// VERTICES
// ============================================================================

// Customer represents a unique user or account holder.
// Fed from: transactions.csv (customer_id)
// Transformations: None.
CREATE VERTEX Customer (
  PRIMARY_ID customer_id STRING,
  card_count INT
) WITH primary_id_as_attribute="true"

// Card represents a payment card used by a customer.
// Fed from: transactions.csv (card1 through card6)
// Transformations: card_id is constructed, card_network = card4, card_type = card6.
CREATE VERTEX Card (
  PRIMARY_ID card_id STRING,
  customer_id STRING,
  card1 STRING,
  card2 STRING,
  card3 STRING,
  card4 STRING,
  card5 STRING,
  card6 STRING,
  card_network STRING,
  card_type STRING
) WITH primary_id_as_attribute="true"

// Transaction represents a financial event.
// Fed from: transactions.csv
CREATE VERTEX Transaction (
  PRIMARY_ID txn_id STRING,
  transaction_dt INT,
  ts DATETIME,
  amount DOUBLE,
  product_cd STRING,
  channel STRING,
  risk_score DOUBLE,
  addr1 STRING,
  addr2 STRING,
  p_emaildomain STRING,
  r_emaildomain STRING,
  dist1 DOUBLE,
  dist2 DOUBLE
) WITH primary_id_as_attribute="true"

// DeviceProfile represents the digital footprint of an online transaction.
// Fed from: identity.csv (DeviceType, DeviceInfo, id_15, id_23, id_30, id_31, id_33)
// Transformations: device_id constructed as a hash of DeviceInfo + id_30 + id_31 + id_33.
CREATE VERTEX DeviceProfile (
  PRIMARY_ID device_id STRING,
  device_info STRING,
  os STRING,
  browser STRING,
  screen STRING,
  device_type STRING,
  is_new_for_account BOOL,
  proxy_type STRING
) WITH primary_id_as_attribute="true"

// EmailDomain represents the email provider used.
// Fed from: transactions.csv (P_emaildomain, R_emaildomain)
// Transformations: domain is the string domain directly.
CREATE VERTEX EmailDomain (
  PRIMARY_ID domain STRING
) WITH primary_id_as_attribute="true"

// BillingRegion represents a geographic region for billing.
// Fed from: transactions.csv (addr1, addr2)
// Transformations: region_code = addr1, country_code = addr2.
CREATE VERTEX BillingRegion (
  PRIMARY_ID region_code STRING,
  country_code STRING
) WITH primary_id_as_attribute="true"

// ClosedCase represents historical, finalized fraud investigations.
// Fed from: closed_cases_history.csv
// Transformations: No transformations for attributes, strings are mapped directly.
CREATE VERTEX ClosedCase (
  PRIMARY_ID case_id STRING,
  customer_id STRING,
  card_id STRING,
  opened_at DATETIME,
  closed_at DATETIME,
  outcome STRING,
  pattern STRING,
  first_fraud_txn_id STRING,
  n_txns INT,
  exposure_usd DOUBLE,
  actions_taken STRING,
  report_filed BOOL,
  analyst_notes STRING
) WITH primary_id_as_attribute="true"

// InvestigationCase represents our active investigation record.
// Fed from: case_pack.csv plus synthetic creation during execution.
// Transformations: Mapped from case_pack or created internally by the agent.
CREATE VERTEX InvestigationCase (
  PRIMARY_ID case_id STRING,
  opened_at DATETIME,
  trigger_type STRING,
  trigger_text STRING,
  status STRING,
  verdict STRING,
  fraud_probability DOUBLE,
  pattern STRING,
  pattern_description STRING,
  exposure_usd DOUBLE,
  summary STRING,
  stop_reason STRING,
  written_to_graph BOOL
) WITH primary_id_as_attribute="true"

// ResolvedCase represents the case memory node for historical retrieval.
// Fed from: spawned by InvestigationCase closure.
// Transformations: None, attributes passed from the completed InvestigationCase.
CREATE VERTEX ResolvedCase (
  PRIMARY_ID resolved_id STRING,
  original_case_id STRING,
  closed_at DATETIME,
  outcome STRING,
  pattern STRING,
  exposure_usd DOUBLE,
  summary STRING,
  status STRING,
  superseded_by STRING
) WITH primary_id_as_attribute="true"

// DocumentedPattern represents known fraud patterns and typologies.
// Fed from: predefined constants based on fraud policy.
// Transformations: None.
CREATE VERTEX DocumentedPattern (
  PRIMARY_ID pattern_name STRING,
  description STRING,
  policy_rule STRING
) WITH primary_id_as_attribute="true"

// Evidence represents a factual claim supporting an investigation.
// Fed from: generated by agent during investigation context collection.
// Transformations: None.
CREATE VERTEX Evidence (
  PRIMARY_ID evidence_id STRING,
  claim STRING,
  source STRING,
  ref STRING,
  entity_ids STRING
) WITH primary_id_as_attribute="true"

// ============================================================================
// EDGES
// ============================================================================

// OWNS links a Customer to their Card(s).
CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNS_REVERSE"

// MADE links a Card to a Transaction it initiated.
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_REVERSE"

// FROM_DEVICE links a Transaction to the DeviceProfile used.
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="FROM_DEVICE_REVERSE"

// PURCHASER_EMAIL links a Transaction to the EmailDomain used.
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="PURCHASER_EMAIL_REVERSE"

// BILLED_IN links a Transaction to the BillingRegion.
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="BILLED_IN_REVERSE"

// NEXT links a Transaction to the chronologically next Transaction on the same card.
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction, dt INT) WITH REVERSE_EDGE="NEXT_REVERSE"

// INVOLVES_TXN links a historical ClosedCase to the associated Transaction(s).
CREATE DIRECTED EDGE INVOLVES_TXN (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVES_TXN_REVERSE"

// ON_CARD links a historical ClosedCase to the primary Card.
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="ON_CARD_REVERSE"

// CONNECTED_TO links a historical ClosedCase to other associated Cards.
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CONNECTED_TO_REVERSE"

// INVESTIGATES links an active InvestigationCase to the target Transaction(s).
CREATE DIRECTED EDGE INVESTIGATES (FROM InvestigationCase, TO Transaction) WITH REVERSE_EDGE="INVESTIGATES_REVERSE"

// INVOLVES_CARD links a ClosedCase to context Card entities.
CREATE DIRECTED EDGE INVOLVES_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="INVOLVES_CARD_REVERSE"

// INVOLVES_CUSTOMER links a ClosedCase to context Customer entities.
CREATE DIRECTED EDGE INVOLVES_CUSTOMER (FROM ClosedCase, TO Customer) WITH REVERSE_EDGE="INVOLVES_CUSTOMER_REVERSE"

// INVOLVES_DEVICE links a ClosedCase to context DeviceProfile entities.
CREATE DIRECTED EDGE INVOLVES_DEVICE (FROM ClosedCase, TO DeviceProfile) WITH REVERSE_EDGE="INVOLVES_DEVICE_REVERSE"

// INVOLVES_REGION links a ClosedCase to context BillingRegion entities.
CREATE DIRECTED EDGE INVOLVES_REGION (FROM ClosedCase, TO BillingRegion) WITH REVERSE_EDGE="INVOLVES_REGION_REVERSE"

// HAS_EVIDENCE links an InvestigationCase to collected Evidence nodes.
CREATE DIRECTED EDGE HAS_EVIDENCE (FROM InvestigationCase, TO Evidence) WITH REVERSE_EDGE="HAS_EVIDENCE_REVERSE"

// RESOLVED_AS links an active InvestigationCase to its final ResolvedCase memory node.
CREATE DIRECTED EDGE RESOLVED_AS (FROM InvestigationCase, TO ResolvedCase) WITH REVERSE_EDGE="RESOLVED_AS_REVERSE"

// MATCHED_PATTERN links a ResolvedCase to the recognized DocumentedPattern.
CREATE DIRECTED EDGE MATCHED_PATTERN (FROM ResolvedCase, TO DocumentedPattern) WITH REVERSE_EDGE="MATCHED_PATTERN_REVERSE"

// INVOLVED_ENTITY_CARD links a ResolvedCase to contextual Card entities.
CREATE DIRECTED EDGE INVOLVED_ENTITY_CARD (FROM ResolvedCase, TO Card) WITH REVERSE_EDGE="INVOLVED_ENTITY_CARD_REVERSE"

// INVOLVED_ENTITY_CUSTOMER links a ResolvedCase to contextual Customer entities.
CREATE DIRECTED EDGE INVOLVED_ENTITY_CUSTOMER (FROM ResolvedCase, TO Customer) WITH REVERSE_EDGE="INVOLVED_ENTITY_CUSTOMER_REVERSE"

// INVOLVED_ENTITY_DEVICE links a ResolvedCase to contextual DeviceProfile entities.
CREATE DIRECTED EDGE INVOLVED_ENTITY_DEVICE (FROM ResolvedCase, TO DeviceProfile) WITH REVERSE_EDGE="INVOLVED_ENTITY_DEVICE_REVERSE"

// INVOLVED_ENTITY_REGION links a ResolvedCase to contextual BillingRegion entities.
CREATE DIRECTED EDGE INVOLVED_ENTITY_REGION (FROM ResolvedCase, TO BillingRegion) WITH REVERSE_EDGE="INVOLVED_ENTITY_REGION_REVERSE"

// ============================================================================
// SUMMARY
// Total Vertex Types: 11
// Total Edge Types: 21
// ============================================================================
